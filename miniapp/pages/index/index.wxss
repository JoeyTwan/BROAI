.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.setup-warn {
  background: rgba(244,63,94,0.15);
  border: 1px solid rgba(244,63,94,0.3);
  color: #fecaca;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
}

.scenes-wrap {
  padding: 40rpx 32rpx;
  flex: 1;
}

.welcome {
  text-align: center;
  margin-bottom: 48rpx;
}
.welcome-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.welcome-desc {
  display: block;
  font-size: 28rpx;
  color: #94a3b8;
}

.scenes {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.scene-card {
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2);
}
.scene-emoji {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}
.scene-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}
.scene-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
}

.chips-wrap {
  margin-top: 48rpx;
  padding: 32rpx;
  border-radius: 24rpx;
}
.chips-title {
  display: block;
  font-size: 28rpx;
  color: #cbd5e1;
  margin-bottom: 24rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(148,163,184,0.3);
  background: rgba(15,23,42,0.5);
  font-size: 26rpx;
  color: #e2e8f0;
}

.chat-area {
  flex: 1;
  padding: 24rpx 24rpx 0;
}
.msg-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 200rpx;
}
.msg-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.msg-user {
  flex-direction: row-reverse;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.ai-avatar {
  background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
  color: #fff;
}
.msg-bubble {
  max-width: 80%;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}
.bubble-user {
  background: #0ea5e9;
  color: #fff;
  border-top-right-radius: 8rpx;
}
.bubble-ai {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(148,163,184,0.18);
  color: #f1f5f9;
  border-top-left-radius: 8rpx;
}

.card-container {
  width: 100%;
}
.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.card-info {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 24rpx;
}
.card-section {
  margin-top: 24rpx;
}
.section-title {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.day-plan {
  background: rgba(15,23,42,0.5);
  border: 1px solid rgba(51,65,85,0.6);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.day-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.day-badge {
  background: rgba(14,165,233,0.2);
  color: #7dd3fc;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.day-title {
  font-size: 30rpx;
  font-weight: 500;
}
.day-body {
  font-size: 26rpx;
  color: #cbd5e1;
}
.time-label {
  color: #64748b;
}
.day-tips {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(239,68,68,0.15);
  border: 1px solid rgba(248,113,113,0.3);
  color: #fecaca;
  font-size: 24rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(14,165,233,0.1);
  border: 1px solid rgba(14,165,233,0.3);
  color: #e0f2fe;
  font-size: 24rpx;
}
.tip-item {
  font-size: 26rpx;
  color: #cbd5e1;
  margin-bottom: 8rpx;
}

.ingredient-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed rgba(51,65,85,0.6);
  font-size: 28rpx;
}
.amount {
  color: #64748b;
}

.step-row {
  background: rgba(15,23,42,0.5);
  border: 1px solid rgba(51,65,85,0.6);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.step-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(249,115,22,0.2);
  color: #fdba74;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-title {
  font-size: 30rpx;
  font-weight: 500;
  flex: 1;
}
.step-detail {
  font-size: 26rpx;
  color: #cbd5e1;
  padding-left: 64rpx;
  display: block;
}

.letter-content {
  background: rgba(15,23,42,0.5);
  border: 1px solid rgba(51,65,85,0.6);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.letter-para {
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
  margin-bottom: 24rpx;
  color: #f1f5f9;
}
.letter-sig {
  display: block;
  text-align: right;
  color: #94a3b8;
}
.letter-actions {
  display: flex;
  gap: 16rpx;
}

.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(15,23,42,0.95);
  border-top: 1px solid rgba(51,65,85,0.5);
}
.input-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}
.mic-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: rgba(51,65,85,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.mic-active {
  background: #ef4444;
  animation: mic-pulse 1.4s infinite;
}
.mic-disabled {
  opacity: 0.3;
  filter: grayscale(1);
}
@keyframes mic-pulse {
  0% { box-shadow: 0 0 0 0 rgba(239,68,68,0.5); }
  70% { box-shadow: 0 0 0 20rpx rgba(239,68,68,0); }
  100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); }
}
.input-field {
  flex: 1;
  min-height: 88rpx;
  max-height: 300rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(15,23,42,0.6);
  border: 1px solid rgba(51,65,85,0.6);
  color: #f8fafc;
  font-size: 32rpx;
  line-height: 1.5;
}
.input-ph {
  color: #64748b;
}
.speak-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: rgba(51,65,85,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.send-btn {
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 20rpx;
  background: #0ea5e9;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.send-disabled {
  opacity: 0.5;
}

.typing {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #94a3b8;
  animation: typing 1.1s infinite;
}
.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes typing {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}
