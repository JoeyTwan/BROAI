# ===== 后端（Node.js） =====
# 服务端口（对外就是扫二维码访问的端口）
PORT=4000

# 允许跨域访问的前端地址，多个用英文逗号分隔
# 你自己部署完，把这里改成你访问前端的域名，例如：https://broai.example.com
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# 管理员口令：保护 /admin 页的配置入口
# - 生产环境强烈建议改成一段随机长字符串
# - 没改的话，默认值 broai-admin-2025 任何人都能改 API Key，别放公网用
ADMIN_TOKEN=broai-admin-2025

# 你可以选择直接在这里硬编码 LLM 配置（不推荐，还是 /admin 页更方便）
# 一旦填了下面任一项，就会覆盖 /admin 页面里同名字段
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_INPUT_PRICE=0.0008
# LLM_OUTPUT_PRICE=0.002
# LLM_BUDGET_CENTS=300
# LLM_DEVICE_DAY_CAP=25

# Node 运行模式：本地改 development，放公网改 production
NODE_ENV=development
